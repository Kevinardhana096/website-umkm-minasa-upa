# Copy this file to .env.local and fill in the values from Supabase:
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Never expose a Supabase secret/service-role key in NEXT_PUBLIC_* variables.
# Required by admin mutations and persistent chat cache. Keep this server-only and never commit the real value.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: ordered server-side AI chat providers using OpenAI-compatible Chat Completions APIs.
# Only providers with both an API key and model are attempted.
# AI_CHAT_PROVIDER_ORDER=gemini,mistral

# Gemini. GEMINI_* is preferred; AI_CHAT_* below remains backward-compatible
# with the existing single-provider Gemini configuration.
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# GEMINI_API_KEY=your-gemini-server-only-key
# GEMINI_MODEL=your-gemini-model
# AI_CHAT_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# AI_CHAT_API_KEY=your-server-only-ai-key
# AI_CHAT_MODEL=your-model-name

# Mistral fallback provider. Keep every key server-only.
# MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
# MISTRAL_API_KEY=your-mistral-server-only-key
# MISTRAL_MODEL=your-mistral-model

# Optional: Google Search grounding for general questions about Desa/UMKM.
# It uses the native Gemini API, not the OpenAI-compatible chat endpoint.
# It is enabled by default for recognized general-knowledge questions; set false to disable.
# AI_CHAT_WEB_SEARCH_ENABLED=true
# GEMINI_GENERATE_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent

# Optional: persistent Supabase cache for successful web-grounded answers.
# Requires SUPABASE_SERVICE_ROLE_KEY and supabase/chat-answer-cache.sql.
# Cache defaults to 6 hours and is clamped between 60 seconds and 7 days.
# AI_CHAT_WEB_CACHE_ENABLED=true
# AI_CHAT_WEB_CACHE_TTL_SECONDS=21600

# Optional: distributed rate limit for /api/chat. If omitted or unavailable,
# the server uses a bounded in-memory limiter as a local safety net.
# UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional: semantic intent routing. Enabled by default when a chat provider is configured.
# Set false to use only the local fallback patterns.
# AI_CHAT_INTENT_ROUTING_ENABLED=true

# Optional: Mistral web search fallback when Gemini Search is unavailable.
# It uses the Mistral Conversations API, not Chat Completions.
# MISTRAL_CONVERSATIONS_API_URL=https://api.mistral.ai/v1/conversations
# MISTRAL_WEB_SEARCH_MODEL=your-mistral-web-search-model

# Optional: local-only Dev Access shortcut. Never add these to Vercel or production.
# DEV_ACCESS_EMAIL=admin@example.com
# DEV_ACCESS_PASSWORD=local-development-password
