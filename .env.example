# Copy this file to .env.local and fill in the values from Supabase:
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Never expose a Supabase secret/service-role key in NEXT_PUBLIC_* variables.
# Required by the admin user-management API. Keep this server-only and never commit the real value.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: local-only Dev Access shortcut. Never add these to Vercel or production.
# DEV_ACCESS_EMAIL=admin@example.com
# DEV_ACCESS_PASSWORD=local-development-password
